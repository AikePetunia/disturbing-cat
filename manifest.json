{
  "manifest_version": 3,
  "name": "disturbing-cat",
  "version": "0.1",
  "description": "When your cat approaches to your desktop and you can't see what's going on...",
  "homepage_url": "https://github.com/AikePetunia/disturbing-cat",
  "permissions": ["activeTab", "storage", "tabs"],

  "action": {
    "default_icon": "icons/disturbing-cat-32-white.avif",
    "theme_icons": [
      {
        "light": "icons/disturbing-cat-32-black.avif",
        "dark": "icons/disturbing-cat-32-white.avif",
        "size": 32
      }
    ],
    "default_title": "Disturbing-cat !",
    "default_popup": "popup/cat-ui.html"
  },
  "host_permissions": [
    "*://instagram.com/*",
    "*://*.instagr.am/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*"
  ],
  "developer": {
    "name": "Aike"
  }
}
